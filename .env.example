# Template for local environment variables. Copy this file to .env.local (which is gitignored)
# and fill in real values there — never commit actual secrets to this file.
OPENAI_API_KEY=
OPENAI_MODEL=

# Public PostHog project settings. These identify the analytics project but are not secrets.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
